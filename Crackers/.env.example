# Copy this to .env and fill in your Atlas connection URI
# Keep your real credentials out of version control

MONGODB_URI="mongodb+srv://<username>:<password>@<cluster-url>/<dbname>?retryWrites=true&w=majority"
# Optional: backend API URL (for using MongoDB via server)
VITE_BACKEND_URL=http://localhost:4000
# Backend-only admin credentials
ADMIN_PASSWORD=change-this-password
ADMIN_TOKEN_SECRET=change-this-token-secret

# Email — use Resend on Render FREE tier (SMTP ports are blocked there)
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM=Appu Crackers <orders@appucrackers.in>
STORE_EMAIL=appucrackers@gmail.com

# Gmail SMTP — works locally and on Render PAID plans only
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=appucrackers@gmail.com
SMTP_PASS=your-16-char-google-app-password

# Production CORS (comma-separated frontend URLs)
ALLOWED_ORIGINS=https://appucrackers.in,https://www.appucrackers.in
PUBLIC_API_URL=https://your-render-service.onrender.com
NODE_ENV=production
